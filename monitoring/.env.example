# .env необязателен: у всех переменных в docker-compose.yml есть значения по умолчанию.
# Путь к train.csv относительно monitoring/ (по умолчанию тот же файл, что и в hw2)
TRAIN_DATA_CSV=../data/train.csv

POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db

# пауза между транзакциями симулятора, сек
SEND_INTERVAL_SECONDS=0.1
# доля "атакующих" транзакций из фродовых строк, для проверки алерта
FRAUD_BOOST=0
