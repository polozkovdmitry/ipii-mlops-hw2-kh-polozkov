  "panels": [
    {
      "id": 27,
      "type": "barchart",
      "title": "Плотность распределения скоров",
      "description": "Гистограмма скоров за выбранный интервал, нормированная в плотность (площадь = 1), 20 бинов по 0.05. Ось Y логарифмическая: почти все скоры около нуля. Серая серия - весь поток без фильтров, для сравнения",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH bins AS (SELECT generate_series(0, 19) AS b),\npicked AS (\n  SELECT least(floor(score * 20), 19)::int AS b FROM scores\n  WHERE $__timeFilter(created_at) AND us_state IN ($state) AND merch IN ($merch)\n),\neverything AS (\n  SELECT least(floor(score * 20), 19)::int AS b FROM scores WHERE $__timeFilter(created_at)\n)\nSELECT to_char(bins.b / 20.0, 'FM0.00') || '-' || to_char((bins.b + 1) / 20.0, 'FM0.00') AS \"скор\",\n       (SELECT count(*) FROM picked WHERE picked.b = bins.b)::float\n         / greatest((SELECT count(*) FROM picked), 1) / 0.05 AS \"выбранный срез\",\n       (SELECT count(*) FROM everything WHERE everything.b = bins.b)::float\n         / greatest((SELECT count(*) FROM everything), 1) / 0.05 AS \"весь поток\"\nFROM bins ORDER BY bins.b",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "весь поток"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xTickLabelRotation": -45,
        "showValue": "never",
        "groupWidth": 0.8,
        "barWidth": 0.9,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "TPS по выбранным штатам и мерчантам",
      "description": "Записанные скоры в секунду, окно 10 секунд",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '10s', 0),\n       count(*) / 10.0 AS \"TPS\"\nFROM scores\nWHERE $__timeFilter(created_at) AND us_state IN ($state) AND merch IN ($merch)\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 29,
      "type": "barchart",
      "title": "Доля фрода по категориям, последние 1000 транзакций",
      "description": "Среднее fraud_flag по cat_id среди 1000 последних записанных скоров (фильтры не применяются)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT cat_id AS \"категория\",\n       round(100.0 * avg(fraud_flag), 2) AS \"помечено фродом, %\"\nFROM (SELECT cat_id, fraud_flag FROM scores ORDER BY id DESC LIMIT 1000) last_1000\nGROUP BY cat_id\nORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Деньги: пойманный и пропущенный фрод, $ в минуту",
      "description": "Сумма транзакций в минуту по исходу: модель поймала фрод / пропустила фрод / заблокировала честную транзакцию. target берётся из разметки train.csv, которую симулятор отдаёт вместе с транзакцией",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1m', 0),\n       coalesce(sum(amount) FILTER (WHERE fraud_flag = 1 AND target = 1), 0) AS \"фрод заблокирован\",\n       coalesce(sum(amount) FILTER (WHERE fraud_flag = 0 AND target = 1), 0) AS \"фрод пропущен\",\n       coalesce(sum(amount) FILTER (WHERE fraud_flag = 1 AND target = 0), 0) AS \"ложная блокировка\"\nFROM scores\nWHERE $__timeFilter(created_at) AND us_state IN ($state) AND merch IN ($merch)\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "currencyUSD",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "фрод заблокирован"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
